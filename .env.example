# Server Configuration
PORT=4000
GLOBAL_PREFIX=api

# Database
# 로컬 개발 시 SQLite 사용, Render/클라우드 배포 시 DATABASE_URL(Postgres) 입력
DB_DATABASE=data/database.sqlite
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Google Drive Storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=Couple_Drive

# Fallback Local Storage
UPLOAD_PATH=./uploads

# Auth
JWT_SECRET=develop_secret_key_change_me
JWT_EXPIRATION=30d

# Security
# 두 분의 회원가입이 끝난 후 false로 변경하면 신규 회원가입이 원천 차단됩니다. (기본값: true)
ALLOW_SIGNUP=true
